# =====================================================
# MOSISAA ADDUNYAA ABBAA CARRAA - Environment Variables
# Copy this file to `.env.local` and fill in your values.
# NEVER commit `.env.local` to version control.
# =====================================================

# --- Supabase ---
# Project URL: Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Anon public key (safe to expose in browser)
# Supabase Dashboard -> Project Settings -> API -> anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Service role key (SECRET - NEVER expose to browser)
# Supabase Dashboard -> Project Settings -> API -> service_role secret key
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Chapa (Ethiopian payment provider) Production/Test keys ---
# Get from https://dashboard.chapa.co -> Settings -> API keys
CHAPA_SECRET_KEY=YOUR_CHAPA_SECRET_KEY
NEXT_PUBLIC_CHAPA_ENV=test   # 'test' or 'live'

# --- App ---
APP_NAME="Mosisaa Addunyaa Abbaa Carraa"
DEFAULT_TICKET_PRICE=300
